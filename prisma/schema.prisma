// Modelo multi-tenant.
//
// Regra única: TUDO que varia entre lojas é coluna de Tenant ou linha ligada
// a um tenantId. Nada de configuração por loja em código, arquivo ou env.
// É isso que faz criar uma loja custar um INSERT e não um deploy.

generator client {
  provider      = "prisma-client-js"
  // Build local no Windows, execução no Hetzner (Debian, OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  SITE      // vitrine sem carrinho — R$ 79/mês
  LOJA      // loja completa — R$ 119/mês (âncora)
  LOJA_PRO  // + automações, relatórios, NF-e — R$ 349/mês
}

enum TenantStatus {
  PROVISIONANDO
  ATIVA
  SUSPENSA   // inadimplente: a loja mostra aviso e some o checkout
  CANCELADA  // sai do ar; dados ficam 90 dias
}

model Tenant {
  id        String       @id @default(cuid())
  /// Identificador estável: vira <slug>.lojas.avilaops.com e o nome do container de dados.
  slug      String       @unique
  nome      String
  plano     Plano        @default(LOJA)
  status    TenantStatus @default(PROVISIONANDO)

  /// Hosts que resolvem para esta loja (domínio próprio, www, apex). O subdomínio
  /// <slug>.LOJAS_BASE_DOMAIN resolve sempre, sem precisar estar aqui.
  dominios  String[]     @default([])
  /// Domínio principal, usado em links absolutos, sitemap e e-mail.
  dominioPrincipal String?

  // ── Identidade visual (só tokens; layout é um só) ─────────────────────
  logoUrl     String?
  bannerUrl   String?                    // imagem de fundo do topo da home
  tema        Json      @default("{}")   // TemaLoja em src/lib/tema.ts
  identidade  Json      @default("{}")   // diagnóstico, voz e direção fotográfica
  slogan      String?
  sobre       String?                    // texto da página "Sobre"

  // ── Contato e operação ───────────────────────────────────────────────
  whatsapp    String?                    // só dígitos, com DDI
  telefone    String?
  emailContato String?
  instagram   String?
  endereco    Json?                      // { logradouro, numero, bairro, cidade, uf, cep }
  /// Exibir o endereço no site (rodapé, contato, JSON-LD). Falso por padrão:
  /// loja só online não expõe onde fica o estoque.
  enderecoPublico Boolean @default(false)
  horario     String?

  // ── Entrega ──────────────────────────────────────────────────────────
  cepOrigem         String?
  retiradaNaLoja    Boolean @default(true)
  despachoDiasUteis Int     @default(1)
  /// Caixa padrão (cm) e peso padrão (kg) para produto sem medida cadastrada.
  caixaPadrao       Json    @default("{\"altura\":15,\"largura\":20,\"comprimento\":25}")
  pesoPadraoKg      Float   @default(1)
  /// Tabela própria por UF, usada quando a cotação por API não está disponível.
  /// [{ "ufs": ["SP"], "preco": 1990, "prazoDiasUteis": 3, "nome": "Sedex" }]
  tabelaFrete       Json    @default("[]")
  freteGratisAcima  Int?                 // centavos

  // ── Pagamento (tokens cifrados com LOJAS_SECRET) ──────────────────────
  mpPublicKey        String?
  mpAccessTokenEnc   String?
  mpWebhookSecretEnc String?
  meiosPagamento     String[] @default(["pix", "cartao", "boleto"])

  // ── E-mail (mail.avilaops.com) ────────────────────────────────────────
  emailRemetente String?   // pedidos@dominio — de onde saem as notificações

  // ── Analytics e buscadores ────────────────────────────────────────────
  gtmId String?
  /// Conteúdo da meta de verificação (só o valor, não a tag inteira).
  verificacaoGoogle String?
  verificacaoBing   String?
  /// Último aviso enviado ao IndexNow — mostrado no painel.
  indexadoEm        DateTime?

  /// Log dos passos de provisionamento: { dns: "ok"|"pendente"|"erro:...", mail: ..., n8n: ... }
  provisionamento Json @default("{}")

  // ── Acesso do lojista ao painel (lojas.avilaops.com/painel) ───────────
  loginEmail String? @unique
  senhaHash  String?   // scrypt, ver src/lib/sessao.ts

  // ── Mensalidade (assinatura no Mercado Pago da Avila Ops) ─────────────
  assinaturaId        String?  @unique   // preapproval_id
  assinaturaStatus    String   @default("SEM_ASSINATURA") // SEM_ASSINATURA | PENDENTE | AUTORIZADA | PAUSADA | CANCELADA
  assinaturaInitPoint String?            // link para cadastrar o cartão, enquanto PENDENTE
  ultimoPagamentoEm   DateTime?
  tentativasFalhas    Int      @default(0)
  suspensaEm          DateTime?
  setupPagoEm         DateTime?          // R$ 497 — cobrado à parte, marcado pela Avila Ops

  faturas         Fatura[]
  cobrancaEventos CobrancaEvento[]
  cupons          Cupom[]
  compradores     Comprador[]
  checkoutsAbertos CheckoutAberto[]
  avaliacoes      Avaliacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categorias Categoria[]
  produtos   Produto[]
  pedidos    Pedido[]

  @@index([status])
}

model Categoria {
  id        String  @id @default(cuid())
  tenantId  String
  slug      String
  nome      String
  descricao String?
  imagemUrl String?
  ordem     Int     @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([tenantId, slug])
}

model Produto {
  id          String  @id @default(cuid())
  tenantId    String
  categoriaId String?
  slug        String
  nome        String
  marca       String?
  sku         String?
  gtin        String?
  /// Centavos. Nunca float — ver packages/checkout/src/core/types.ts.
  precoCentavos     Int
  precoDeCentavos   Int?     // "de R$ X por R$ Y"
  descricaoCurta    String?
  descricao         String?
  imagens           String[] @default([])
  destaque          Boolean  @default(false)
  ativo             Boolean  @default(true)
  disponibilidade   String   @default("in_stock") // in_stock | out_of_stock | backorder
  estoque           Int?
  /// Peso em kg e medidas em cm. Sem eles, o frete usa a caixa padrão do tenant.
  pesoKg        Float?
  alturaCm      Float?
  larguraCm     Float?
  comprimentoCm Float?
  atributos     Json     @default("{}") // livre: { "volumeMl": 500, "cor": "azul" }
  /// Nomes das opções de variação, na ordem de exibição: ["Tamanho", "Cor"].
  /// Vazio = produto simples (estoque no próprio produto).
  opcoes        String[] @default([])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  itens     PedidoItem[]
  variantes Variante[]
  avaliacoes Avaliacao[]

  @@unique([tenantId, slug])
  @@index([tenantId, ativo, destaque])
}

enum PedidoStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  ESTORNADO
}

model Pedido {
  id          String       @id @default(cuid())
  tenantId    String
  /// Referência pública e idempotente (a do checkout). É o que o cliente vê.
  referencia  String       @unique
  numero      Int          @default(autoincrement())
  status      PedidoStatus @default(AGUARDANDO_PAGAMENTO)

  clienteNome     String
  clienteEmail    String
  clienteTelefone String
  clienteDocumento String
  entrega         Json?      // EnderecoEntrega ou null (retirada)
  freteNome       String
  freteCentavos   Int
  subtotalCentavos Int
  descontoCentavos Int @default(0)
  cupomCodigo      String?
  compradorId      String?
  /// Estoque já baixado para este pedido (evita baixar duas vezes no webhook).
  estoqueBaixado   Boolean @default(false)
  totalCentavos    Int

  meioPagamento   String     // pix | cartao | boleto
  gateway         String     @default("mercadopago")
  pagamentoId     String?
  pagamentoStatus String?
  rastreio        String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprador Comprador?  @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  itens     PedidoItem[]

  @@index([tenantId, status])
  @@index([pagamentoId])
}

/// Variação de um produto (P/Azul, 500ml…). O que o carrinho envia é
/// `<produtoId>:<varianteId>`; preço nulo herda o do produto.
model Variante {
  id            String  @id @default(cuid())
  produtoId     String
  /// Valores na ordem de Produto.opcoes: { "Tamanho": "P", "Cor": "Azul" }
  valores       Json
  nome          String            // "P / Azul" — derivado, para exibir e para o pedido
  sku           String?
  precoCentavos Int?
  estoque       Int?              // null = não controla
  pesoKg        Float?
  imagem        String?
  ativo         Boolean @default(true)
  ordem         Int     @default(0)

  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  itens   PedidoItem[]

  @@index([produtoId, ativo])
}

/// Cupom de desconto da loja.
model Cupom {
  id             String    @id @default(cuid())
  tenantId       String
  codigo         String                     // maiúsculo, sem espaço
  tipo           String                     // PERCENTUAL | FIXO | FRETE_GRATIS
  valor          Int       @default(0)      // % (0–100) ou centavos
  minimoCentavos Int       @default(0)
  usosMax        Int?
  usos           Int       @default(0)
  validoAte      DateTime?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
}

/// Uma cobrança mensal da assinatura (authorized_payment do Mercado Pago).
model Fatura {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String   @unique   // id do authorized_payment
  centavos   Int
  status     String              // approved | rejected | pending | …
  detalhe    String?
  pagaEm     DateTime?
  criadoEm   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
}

/// Notificação do Mercado Pago já vista — idempotência do webhook.
model CobrancaEvento {
  id             String    @id @default(cuid())
  notificacaoId  String    @unique   // "<topic>:<data.id>"
  tenantId       String?
  topico         String
  processadoEm   DateTime?
  erro           String?
  criadoEm       DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model PedidoItem {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String?
  nome       String
  sku        String?
  quantidade Int
  precoUnitarioCentavos Int
  varianteId   String?
  varianteNome String?

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto  Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  variante Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
}

/// Checkout iniciado (a pessoa se identificou) mas ainda sem pedido. É a
/// matéria-prima do carrinho abandonado. Vira CONVERTIDO quando o pedido nasce.
model CheckoutAberto {
  id              String    @id @default(cuid())
  tenantId        String
  referencia      String    @unique
  clienteNome     String
  clienteEmail    String
  clienteTelefone String
  itens           Json      // [{ id, nome, quantidade, precoUnitario }]
  totalCentavos   Int
  status          String    @default("ABERTO") // ABERTO | LEMBRADO | CONVERTIDO
  lembradoEm      DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, criadoEm])
}

/// Avaliação de produto pelo comprador. Só aparece depois de aprovada no painel.
model Avaliacao {
  id        String   @id @default(cuid())
  tenantId  String
  produtoId String
  nome      String
  nota      Int      // 1–5
  texto     String?
  aprovada  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, aprovada])
  @@index([tenantId, aprovada, criadoEm])
}

/// Conta do comprador NA LOJA (não é o lojista). Escopo por tenant: o mesmo
/// e-mail pode ter conta em lojas diferentes, e uma loja nunca enxerga o
/// cadastro da outra.
model Comprador {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  senhaHash  String
  nome       String
  telefone   String?
  documento  String?
  criadoEm   DateTime @default(now())
  ultimoAcesso DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enderecos  EnderecoComprador[]
  pedidos    Pedido[]

  @@unique([tenantId, email])
}

/// Endereço salvo pelo comprador — evita redigitar CEP e rua a cada compra.
model EnderecoComprador {
  id          String  @id @default(cuid())
  compradorId String
  apelido     String?
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  principal   Boolean @default(false)

  comprador Comprador @relation(fields: [compradorId], references: [id], onDelete: Cascade)

  @@index([compradorId])
}
