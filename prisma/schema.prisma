// Modelo multi-tenant.
//
// Regra única: TUDO que varia entre lojas é coluna de Tenant ou linha ligada
// a um tenantId. Nada de configuração por loja em código, arquivo ou env.
// É isso que faz criar uma loja custar um INSERT e não um deploy.

generator client {
  provider      = "prisma-client-js"
  // Build local no Windows, execução no Hetzner (Debian, OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  SITE // vitrine sem carrinho — R$ 79/mês
  LOJA // loja completa — R$ 119/mês (âncora)
  LOJA_PRO // + automações, relatórios, NF-e — R$ 349/mês
}

enum TenantStatus {
  PROVISIONANDO
  ATIVA
  SUSPENSA // inadimplente: a loja mostra aviso e some o checkout
  CANCELADA // sai do ar; dados ficam 90 dias
}

model Tenant {
  id     String       @id @default(cuid())
  /// Identificador estável: vira <slug>.lojas.avilaops.com e o nome do container de dados.
  slug   String       @unique
  nome   String
  plano  Plano        @default(LOJA)
  status TenantStatus @default(PROVISIONANDO)

  /// Hosts que resolvem para esta loja (domínio próprio, www, apex). O subdomínio
  /// <slug>.LOJAS_BASE_DOMAIN resolve sempre, sem precisar estar aqui.
  dominios         String[] @default([])
  /// Domínio principal, usado em links absolutos, sitemap e e-mail.
  dominioPrincipal String?

  // ── Identidade visual (só tokens; layout é um só) ─────────────────────
  logoUrl                 String?
  bannerUrl               String? // imagem de fundo do topo da home
  /// Ícone da aba. Vazio = a plataforma desenha a inicial do nome sobre a cor
  /// primária (ver src/app/icon.tsx), que é o padrão e serve a maioria. Quem
  /// tem símbolo próprio aponta o arquivo aqui: o logo do cabeçalho não serve,
  /// porque é horizontal e some em 16 px.
  faviconUrl              String?
  tema                    Json    @default("{}") // TemaLoja em src/lib/tema.ts
  identidade              Json    @default("{}") // diagnóstico, voz e direção fotográfica
  slogan                  String?
  /**
   * Segmento da loja. Liga blocos de vitrine específicos do ramo sem código
   * por loja: "motopecas" ativa a garagem (peças por moto), compatibilidade
   * e busca por código original. "geral" é a loja comum.
   */
  segmento                String  @default("geral")
  /**
   * Responsável técnico da farmácia (segmento "farmacia").
   * RDC 44/2009, art. 55: farmácia que dispensa a distância só existe
   * legalmente com farmacêutico responsável identificado, CRF visível e
   * licença sanitária declarada. É campo do tenant, e não texto solto numa
   * página "sobre", pelo mesmo motivo que o CNPJ já é: o rodapé monta
   * sozinho e ninguém pode esquecer de escrever.
   */
  farmaceuticoResponsavel String?
  farmaceuticoCrf         String? // "CRF-SP 12345"
  licencaSanitaria        String? // nº do alvará/licença da vigilância sanitária
  autorizacaoAnvisa       String? // AFE — Autorização de Funcionamento de Empresa

  /// Barra fina acima do cabeçalho. Um texto curto, o mesmo em toda a loja:
  /// é o lugar de "frete grátis acima de X" e de aviso de prazo em data
  /// especial, sem ninguém pedir uma página nova.
  avisoTopo String?
  sobre     String? // texto da página "Sobre"

  // ── Contato e operação ───────────────────────────────────────────────
  whatsapp             String? // só dígitos, com DDI
  telefone             String?
  emailContato         String?
  instagram            String?
  /// Identificação do fornecedor — Decreto 7.962/2013, art. 2º. Toda loja na
  /// internet tem que exibir razão social, CNPJ e endereço em destaque; aqui
  /// isso é campo do tenant e vai para o rodapé sozinho, sem depender de o
  /// lojista lembrar de escrever numa página solta.
  razaoSocial          String?
  cnpj                 String? // 14 dígitos, sem máscara
  endereco             Json? // { logradouro, numero, bairro, cidade, uf, cep }
  /// Exibir o endereço no site (rodapé, contato, JSON-LD). Falso por padrão:
  /// loja só online não expõe onde fica o estoque.
  enderecoPublico      Boolean @default(false)
  /// Deixa crawlers de TREINAMENTO (GPTBot, Google-Extended, ClaudeBot, CCBot)
  /// lerem a loja. Não tem relação com aparecer na busca do Google, do Bing ou
  /// do ChatGPT, que é sempre liberada em loja ativa. Ver src/lib/descoberta.ts.
  permiteTreinamentoIa Boolean @default(false)
  horario              String?

  // ── Entrega ──────────────────────────────────────────────────────────
  cepOrigem              String?
  retiradaNaLoja         Boolean @default(true)
  despachoDiasUteis      Int     @default(1)
  /// A partir de quantas unidades o estoque conta como baixo: avisa o lojista
  /// no painel e vira "últimas unidades" na loja. Zero desliga os dois.
  estoqueBaixoEm         Int     @default(3)
  /// Teto de postagem adiantada pela Avila Ops que esta loja pode acumular sem
  /// acertar. Zero desliga o limite. Padrão de R$ 300: cerca de dez envios.
  limitePostagemCentavos Int     @default(30000)
  /// Caixa padrão (cm) e peso padrão (kg) para produto sem medida cadastrada.
  caixaPadrao            Json    @default("{\"altura\":15,\"largura\":20,\"comprimento\":25}")
  pesoPadraoKg           Float   @default(1)
  /// Tabela própria por UF, usada quando a cotação por API não está disponível.
  /// [{ "ufs": ["SP"], "preco": 1990, "prazoDiasUteis": 3, "nome": "Sedex" }]
  tabelaFrete            Json    @default("[]")
  /// Entrega feita pela própria loja (motoboy, frota), por prefixo de CEP. Não
  /// substitui a transportadora: concorre com ela em preço no mesmo checkout.
  /// [{ "prefixos": ["14"], "nome": "Motoboy Ribeirão", "preco": 1500,
  ///    "prazoDiasUteis": 0, "gratisAcima": 19900 }]
  entregaLocal           Json    @default("[]")
  freteGratisAcima       Int? // centavos

  // ── Pagamento (tokens cifrados com LOJAS_SECRET) ──────────────────────
  /// Mercado Pago é o único gateway, por decisão de escopo de 31/08/2026.
  /// A conta é do lojista: o dinheiro nunca passa pela Avila Ops.
  mpPublicKey        String?
  mpAccessTokenEnc   String?
  mpWebhookSecretEnc String?

  // ── Mercado Livre ─────────────────────────────────────────────────────
  /// Mesma conta do Mercado Pago (provado em 02/09/2026: o token do MP
  /// responde em api.mercadolibre.com/users/me), mas com escopo de venda,
  /// que o token de pagamento não tem. Por isso credencial separada.
  mlUserId          String?
  mlNickname        String?
  mlAccessTokenEnc  String?
  /// offline_access: sem o refresh, o acesso morre em 6 horas.
  mlRefreshTokenEnc String?
  mlExpiraEm        DateTime?
  /// Quando o lojista conectou. Nulo = nunca conectou.
  mlConectadoEm     DateTime?

  /**
   * Regras comerciais por canal de venda: acréscimo de preço, estoque
   * reservado, tipo de anúncio, garantia. Ver RegrasDoCanal em src/lib/canais.ts.
   * { "mercadolivre": { "acrescimoPercentual": 16.3, "estoqueReservado": 1, ... } }
   * É JSON e não coluna por canal porque a pergunta é a mesma no Mercado Livre,
   * na Amazon e na Shopee — "por quanto e com quanto estoque vai para lá" —, e
   * o dia em que a Shopee entrar não pode ser o dia de uma migração de seis
   * colunas. Chave ausente = o padrão de REGRAS_PADRAO, que é exatamente o que
   * a integração fazia antes destes campos existirem.
   */
  canais         Json     @default("{}")
  meiosPagamento String[] @default(["pix", "cartao", "boleto"])

  // ── E-mail (mail.avilaops.com) ────────────────────────────────────────
  emailRemetente String? // pedidos@dominio — de onde saem as notificações

  // ── Políticas da loja ─────────────────────────────────────────────────
  /**
   * /**
   * /**
   * /**
   * Políticas escritas pelo lojista, por tipo ("envio", "devolucao",
   * "privacidade", "termos", "aviso-legal").
   * Chave ausente = a loja publica o modelo da plataforma, que é o
   * comportamento de sempre e o que garante CDC e LGPD em loja nova sem
   * ninguém escrever nada. O lojista só grava aqui quando quer o texto dele,
   * e o painel oferece o modelo como ponto de partida.
   * { "envio": { "corpo": "...", "atualizadoEm": "2026-09-17T..." } }
   */
  politicas       Json @default("{}")
  /**
   * Regras de devolução e cancelamento. Número, não prosa: é o que a
   * plataforma consegue conferir e escrever na política sozinha.
   * Ver RegrasDevolucao em src/lib/politicas.ts.
   */
  regrasDevolucao Json @default("{}")

  // ── Campos personalizados do catálogo ─────────────────────────────────
  /**
   * /**
   * /**
   * /**
   * Definições de campo que esta loja acrescenta ao produto. Lista, porque a
   * ordem é a de exibição na ficha.
   * Existe porque `atributos` é um saco livre: serve para gravar, não para
   * pedir. Sem definição, o painel não sabe que rótulo mostrar, que tipo
   * validar nem o que publicar; com ela, a loja de tinta cadastra "Rendimento
   * por litro" e a de vinho "Safra" sem nenhuma das duas virar código.
   * Ver CampoPersonalizado em src/lib/campos-personalizados.ts.
   */
  camposPersonalizados Json @default("[]")

  // ── Analytics, anúncios e buscadores ──────────────────────────────────
  gtmId                 String?
  /// Pixels da loja. Cada um é opcional; sem id, o script nem é carregado.
  metaPixelId           String? // Meta (Facebook/Instagram) — 15-16 dígitos
  ga4Id                 String? // Google Analytics 4 — G-XXXXXXX
  googleAdsId           String? // Google Ads — AW-XXXXXXXXX
  googleAdsRotuloCompra String? // rótulo da conversão de compra
  tiktokPixelId         String?
  /// Conta do Google Merchant Center (só os dígitos). Liga o convite do Google
  /// Avaliações do Consumidor no pedido pago. Ver src/lib/avaliacoes-google.ts.
  googleMerchantId      String?
  /// Selo do Google Avaliações do Consumidor na vitrine. Escolha da loja.
  googleSeloAvaliacoes  Boolean @default(false)
  /// Conteúdo da meta de verificação (só o valor, não a tag inteira).
  verificacaoGoogle     String?
  verificacaoBing       String?
  /// Último aviso enviado ao IndexNow — mostrado no painel.
  indexadoEm            DateTime?

  /// Log dos passos de provisionamento: { dns: "ok"|"pendente"|"erro:...", mail: ..., n8n: ... }
  provisionamento Json @default("{}")

  // ── Acesso do lojista ao painel (lojas.avilaops.com/painel) ───────────
  loginEmail String? @unique
  senhaHash  String? // scrypt, ver src/lib/sessao.ts
  /// Fim do período de teste. Nulo nas lojas anteriores ao cadastro por conta,
  /// que seguem com os 14 dias contados de `criadoEm` (ver src/lib/planos.ts).
  testeAte   DateTime?

  // ── Mensalidade (assinatura no Mercado Pago da Avila Ops) ─────────────
  assinaturaId        String?   @unique // preapproval_id
  assinaturaStatus    String    @default("SEM_ASSINATURA") // SEM_ASSINATURA | PENDENTE | AUTORIZADA | PAUSADA | CANCELADA
  assinaturaInitPoint String? // link para cadastrar o cartão, enquanto PENDENTE
  ultimoPagamentoEm   DateTime?
  tentativasFalhas    Int       @default(0)
  suspensaEm          DateTime?
  /// Loja da casa (demo, vitrine própria): a rotina diária nunca suspende. Marcado só pela API admin.
  cobrancaIsenta      Boolean   @default(false)
  setupPagoEm         DateTime? // R$ 497 — cobrado à parte, marcado pela Avila Ops

  faturas          Fatura[]
  cobrancaEventos  CobrancaEvento[]
  cupons           Cupom[]
  compradores      Comprador[]
  anunciosMl       AnuncioMercadoLivre[]
  perguntasMl      PerguntaMercadoLivre[]
  reputacaoMl      ReputacaoMercadoLivre?
  checkoutsAbertos CheckoutAberto[]
  avaliacoes       Avaliacao[]
  avisosEstoque    AvisoEstoque[]
  postagens        Postagem[]
  operadores       OperadorLoja[]

  apiKeyEnc      String?
  apiKeyCriadaEm DateTime?
  chavesApi      ChaveApi[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categorias        Categoria[]
  produtos          Produto[]
  pedidos           Pedido[]
  pesquisasCatalogo PesquisaCatalogoExecucao[]
  publicacoes       PublicacaoLoja[]
  sessoesVitrine    SessaoVitrine[]

  @@index([status])
}

model Categoria {
  id        String  @id @default(cuid())
  tenantId  String
  slug      String
  nome      String
  descricao String?
  imagemUrl String?
  ordem     Int     @default(0)

  // SEO persistido: gerado fora do request público e revisável no painel.
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]  @default([])
  seoPendente      Boolean   @default(true)
  seoOrigem        String? // manual | gemini | fallback
  seoModelo        String?
  seoAtualizadoEm  DateTime?
  seoProcessandoEm DateTime?
  seoErro          String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([tenantId, slug])
  @@index([tenantId, seoPendente])
}

model Produto {
  id                   String   @id @default(cuid())
  tenantId             String
  categoriaId          String?
  slug                 String
  nome                 String
  marca                String?
  sku                  String?
  gtin                 String?
  /// Categoria Google confirmada por item: ID ou caminho da taxonomia oficial.
  googleProductCategory String?
  /// Centavos. Nunca float — ver packages/checkout/src/core/types.ts.
  precoCentavos        Int
  precoDeCentavos      Int? // "de R$ X por R$ Y"
  descricaoCurta       String?
  descricao            String?
  imagens              String[] @default([])
  /**
   * De onde a imagem veio, e o quanto ela é deste item:
   * `propria`        foto do SKU exato (própria ou do fabricante com código
   * conferido). É o padrão e não exibe aviso.
   * `representativa` foto de outro item da mesma família visual. A vitrine
   * avisa, porque a peça da foto não é a que vai na caixa.
   * `ilustracao`     desenho gerado das medidas reais do cadastro. A vitrine
   * avisa que é ilustração, não fotografia.
   * Existe porque imagem plausível de produto errado é pior que ausência de
   * imagem: gera compra errada, devolução e desconfiança. Quem escreve a
   * imagem declara o que ela é; a vitrine só obedece.
   */
  imagemOrigem         String   @default("propria")
  /// Família visual da imagem representativa ("6200", "UCP"), para auditoria:
  /// permite achar todo item que herdou uma foto quando ela for substituída.
  imagemFamilia        String?
  destaque             Boolean  @default(false)
  ativo                Boolean  @default(true)
  disponibilidade      String   @default("in_stock") // in_stock | out_of_stock | backorder
  estoque              Int?
  /// Peso em kg e medidas em cm. Sem eles, o frete usa a caixa padrão do tenant.
  pesoKg               Float?
  alturaCm             Float?
  larguraCm            Float?
  comprimentoCm        Float?
  atributos            Json     @default("{}") // livre: { "volumeMl": 500, "cor": "azul" }
  /**
   * Valores dos campos que a loja definiu em `Tenant.camposPersonalizados`,
   * indexados pela chave da definição: { "rendimento-por-litro": "12" }.
   * Separado de `atributos` de propósito: `atributos` é bagagem de
   * importação, que ninguém prometeu exibir; isto aqui tem definição, tipo e
   * rótulo, e a ficha do produto publica.
   */
  camposPersonalizados Json     @default("{}")

  // Peças e acessórios (segmento "motopecas"): a que veículos o item serve.
  // Vazio = universal (capacete, óleo, serviço). Ver src/lib/motos.ts.
  codigoOriginal      String? // código OEM do fabricante da moto
  codigosEquivalentes String[] @default([]) // cross-reference: outras marcas/códigos
  compatibilidade     Json     @default("[]") // [{ marca, modelo, anoDe?, anoAte? }]
  // Farmácia e drogaria (segmento "farmacia"). Ver src/lib/farmacia.ts.
  //
  // A tarja é o único destes campos que muda o que a loja PODE fazer: tarja
  // preta e vermelha com retenção são substâncias sob controle especial, e a
  // venda pela internet delas é proibida (RDC 44/2009, art. 62). Por isso o
  // padrão é "nenhuma" — a esmagadora maioria do catálogo de uma drogaria
  // (fralda, shampoo, dermocosmético) não é medicamento e não restringe nada.
  /// nenhuma | livre | vermelha | vermelha-retencao | preta
  tarja               String   @default("nenhuma")
  /// Substância, como está na caixa: "Dipirona monoidratada". É por ela que o
  /// comprador acha o genérico do que o médico receitou.
  principioAtivo      String?
  /// Dose e quantidade: "500 mg · 20 comprimidos". Junto com o princípio
  /// ativo, é o que permite afirmar que dois itens são intercambiáveis.
  apresentacao        String?
  /// Registro do medicamento na Anvisa, 13 dígitos, sem máscara.
  registroAnvisa      String?
  /// referencia | generico | similar | novo | fitoterapico | manipulado
  tipoMedicamento     String?

  /// Nomes das opções de variação, na ordem de exibição: ["Tamanho", "Cor"].
  /// Vazio = produto simples (estoque no próprio produto).
  opcoes String[] @default([])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Controle de concorrência do catálogo. Campos comerciais acima são projeções.
  versaoCatalogo Int @default(1)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria         Categoria?          @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  itens             PedidoItem[]
  variantes         Variante[]
  midias            MidiaProduto[]
  historicoCatalogo HistoricoCatalogo[]
  avaliacoes        Avaliacao[]
  /// Texto normalizado (minúsculas, sem acento) de nome + marca + sku +
  /// descrição curta. Mantido por gatilho no banco — ver a migração
  /// 20260826200000_busca_sem_acento. Nunca escrever por aqui.
  busca             String              @default("")

  avisosEstoque            AvisoEstoque[]
  anunciosMl               AnuncioMercadoLivre[]
  perguntasMl              PerguntaMercadoLivre[]
  correspondenciasPesquisa CorrespondenciaPesquisaProduto[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  /// `sku` é a chave de idempotência da importação (`importarProdutos`), e era
  /// sustentada só por convenção: a busca era `findFirst`, sem `orderBy`, então
  /// dois produtos com o mesmo SKU faziam a reimportação atualizar um deles ao
  /// acaso — e o outro nunca mais recebia preço nem estoque. Nulo não colide
  /// (índice único do Postgres aceita vários NULL), então produto sem SKU
  /// continua livre.
  @@unique([tenantId, sku])
  @@index([tenantId, ativo, destaque])
  @@index([tenantId, busca])
  /// Trigramas para `busca LIKE '%termo%'`: o btree acima só resolve prefixo.
  /// Ver 20260910200000_busca_trgm_e_categoria.
  @@index([busca(ops: raw("gin_trgm_ops"))], type: Gin, map: "Produto_busca_trgm_idx")
  @@index([tenantId, categoriaId, destaque, nome])
  /// Equivalentes por substância: a página do produto pergunta "quem mais tem
  /// este princípio ativo?" a cada visita, e sem índice isso vira varredura do
  /// catálogo inteiro numa drogaria de dez mil itens.
  @@index([tenantId, principioAtivo])
}

enum PedidoStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  ESTORNADO
}

model Pedido {
  id         String       @id @default(cuid())
  tenantId   String
  /// Referência pública e idempotente (a do checkout). É o que o cliente vê.
  referencia String       @unique
  numero     Int          @default(autoincrement())
  status     PedidoStatus @default(AGUARDANDO_PAGAMENTO)

  clienteNome      String
  clienteEmail     String
  clienteTelefone  String
  clienteDocumento String
  entrega          Json? // EnderecoEntrega ou null (retirada)
  freteNome        String
  freteCentavos    Int
  /// Prazo do frete escolhido, em dias úteis. Nulo em pedido anterior a
  /// 06/10/2026 e em pedido de marketplace.
  fretePrazoDiasUteis Int?
  subtotalCentavos Int
  descontoCentavos Int     @default(0)
  cupomCodigo      String?
  compradorId      String?
  /// Estoque já baixado para este pedido (evita baixar duas vezes no webhook).
  estoqueBaixado   Boolean @default(false)
  totalCentavos    Int

  meioPagamento   String // pix | cartao | boleto
  gateway         String  @default("mercadopago")
  pagamentoId     String?
  pagamentoStatus String?
  rastreio        String?

  /// De onde veio a venda: "loja" (checkout próprio) ou "mercadolivre".
  /// Não é condição por loja — é fato do pedido, e o painel, o relatório e o
  /// n8n precisam distinguir: quem compra no ML fala com o ML, não com a loja.
  canal         String  @default("loja")
  /// Id do pedido no canal externo (`order.id` do ML). É o que torna a
  /// ingestão idempotente: a notificação do ML chega mais de uma vez, e o
  /// mesmo pedido não pode virar dois.
  canalPedidoId String?

  /**
   * Sessão da vitrine em que a compra foi fechada. Nulo em pedido anterior à
   * medição, em compra com cookie recusado e em pedido criado fora do site
   * (marketplace, importação): a atribuição trata os três como "Direto" em
   * vez de fingir um canal.
   */
  sessaoId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprador Comprador?     @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  sessao    SessaoVitrine? @relation(fields: [sessaoId], references: [id], onDelete: SetNull)
  itens     PedidoItem[]
  postagem  Postagem?

  @@unique([tenantId, canal, canalPedidoId])
  @@index([tenantId, status])
  @@index([pagamentoId])
  @@index([sessaoId])
}

/// Unidade vendável. Produto simples tem uma variante padrao interna.
/// precoCentavos/estoque são projeções de PrecoVariante/SaldoEstoque.
model Variante {
  id                    String  @id @default(cuid())
  tenantId              String
  produtoId             String
  padrao                Boolean @default(false)
  /// Valores na ordem de Produto.opcoes: { "Tamanho": "P", "Cor": "Azul" }
  valores               Json
  nome                  String // "P / Azul" — derivado, para exibir e para o pedido
  sku                   String?
  gtin                  String?
  mpn                   String?
  /// desconhecido | informado | sem_identificador. Informado não significa verificado externamente.
  identificadoresEstado String  @default("desconhecido")
  disponibilidade       String  @default("in_stock")
  precoCentavos         Int?
  estoque               Int? // null = não controla
  pesoKg                Float?
  alturaCm              Float?
  larguraCm             Float?
  comprimentoCm         Float?
  imagem                String?
  ativo                 Boolean @default(true)
  ordem                 Int     @default(0)

  produto     Produto            @relation(fields: [tenantId, produtoId], references: [tenantId, id], onDelete: Cascade)
  itens       PedidoItem[]
  preco       PrecoVariante?
  saldos      SaldoEstoque[]
  midias      MidiaProduto[]
  publicacoes PublicacaoCanal[]
  reservas    ReservaEstoque[]
  movimentos  MovimentoEstoque[]

  @@unique([tenantId, id])
  @@unique([tenantId, produtoId, id])
  @@unique([tenantId, sku])
  @@index([produtoId, ativo])
}

/// BRL em centavos. Comparação é o antigo preço "de", sem presumir promoção.
model PrecoVariante {
  varianteId         String   @id
  tenantId           String
  moeda              String   @default("BRL")
  valorCentavos      Int
  comparacaoCentavos Int?
  atualizadoEm       DateTime @default(now()) @updatedAt
  variante           Variante @relation(fields: [tenantId, varianteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, varianteId])
}

/// Disponível = físico menos reservado. Nulo preserva estoque não controlado.
model SaldoEstoque {
  id           String   @id @default(cuid())
  tenantId     String
  varianteId   String
  local        String   @default("principal")
  fisico       Int?
  reservado    Int      @default(0)
  atualizadoEm DateTime @default(now()) @updatedAt
  variante     Variante @relation(fields: [tenantId, varianteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, varianteId, local])
}

model ReservaEstoque {
  id           String   @id @default(cuid())
  tenantId     String
  referencia   String
  varianteId   String
  quantidade   Int
  estado       String   @default("ATIVA")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
  variante     Variante @relation(fields: [tenantId, varianteId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, referencia, varianteId])
  @@index([tenantId, estado])
}

model TentativaCatalogo {
  id           String   @id @default(cuid())
  tenantId     String
  referencia   String
  resumoHash   String
  estado       String   @default("RESERVADA")
  pagamentoId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@unique([tenantId, referencia])
  @@unique([referencia])
}

model MovimentoEstoque {
  id         String   @id @default(cuid())
  tenantId   String
  varianteId String
  chave      String
  quantidade Int
  motivo     String
  criadoEm   DateTime @default(now())
  variante   Variante @relation(fields: [tenantId, varianteId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, chave])
}

/// Acervo por arquivo; varianteId nulo significa mídia compartilhada do produto.
model MidiaProduto {
  id               String    @id @default(cuid())
  tenantId         String
  produtoId        String
  varianteId       String?
  escopo           String    @default("produto")
  url              String
  tipo             String    @default("imagem")
  finalidade       String    @default("galeria")
  ordem            Int       @default(0)
  origem           String    @default("propria")
  familia          String?
  textoAlternativo String?
  fonte            String?
  correspondencia  String    @default("nao_confirmada")
  larguraPx        Int?
  alturaPx         Int?
  criadoEm         DateTime  @default(now())
  produto          Produto   @relation(fields: [tenantId, produtoId], references: [tenantId, id], onDelete: Cascade)
  variante         Variante? @relation(fields: [tenantId, produtoId, varianteId], references: [tenantId, produtoId, id], onDelete: Cascade)

  @@unique([produtoId, escopo, url])
  @@index([tenantId, produtoId, ordem])
}

/// Envio e resultado externo independentes. Sem consulta externa, NÃO_CONSULTADO.
model PublicacaoCanal {
  id               String    @id @default(cuid())
  tenantId         String
  varianteId       String
  canal            String
  contaExterna     String    @default("")
  idExterno        String
  versaoEnviada    Int?
  estadoEnvio      String    @default("NAO_ENVIADO")
  resultadoExterno String    @default("NAO_CONSULTADO")
  enviadoEm        DateTime?
  consultadoEm     DateTime?
  problemas        Json      @default("[]")
  variante         Variante  @relation(fields: [tenantId, varianteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, varianteId, canal, contaExterna])
  @@unique([tenantId, canal, contaExterna, idExterno])
}

model HistoricoCatalogo {
  id        String   @id @default(cuid())
  tenantId  String
  produtoId String
  versao    Int
  origem    String
  campos    String[]
  antes     Json
  depois    Json
  criadoEm  DateTime @default(now())
  produto   Produto  @relation(fields: [tenantId, produtoId], references: [tenantId, id], onDelete: Cascade)

  @@unique([produtoId, versao])
}

/// Outbox gravada na transação do catálogo; o n8n consome pela API autenticada.
model EventoCatalogo {
  id           String    @id @default(cuid())
  tenantId     String
  produtoId    String
  versao       Int
  tipo         String    @default("catalogo.alterado")
  criadoEm     DateTime  @default(now())
  processadoEm DateTime?

  @@unique([produtoId, versao])
  @@index([tenantId, processadoEm, criadoEm])
}

/// Uma execução rastreável de pesquisa externa. O resultado bruto nunca é
/// publicado automaticamente no catálogo.
model PesquisaCatalogoExecucao {
  id               String                           @id @default(cuid())
  tenantId         String
  escopo           String
  estado           String                           @default("EM_ANDAMENTO")
  iniciadoPor      String
  parametros       Json                             @default("{}")
  iniciadoEm       DateTime                         @default(now())
  concluidoEm      DateTime?
  tenant           Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fontes           FontePesquisaCatalogo[]
  correspondencias CorrespondenciaPesquisaProduto[]

  @@index([tenantId, estado, iniciadoEm])
}

/// Página consultada em uma pesquisa; preserva a URL da evidência.
model FontePesquisaCatalogo {
  id           String                      @id @default(cuid())
  execucaoId   String
  url          String
  titulo       String?
  dominio      String
  tipo         String                      @default("pagina_produto")
  coletadoEm   DateTime                    @default(now())
  conteudoHash String?
  execucao     PesquisaCatalogoExecucao    @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  referencias  ReferenciaPesquisaProduto[]
  fatos        FatoPesquisaProduto[]
  imagens      ImagemCandidataProduto[]

  @@unique([execucaoId, url])
}

/// Hipótese auditável de que a pesquisa se refere ao produto da loja.
model CorrespondenciaPesquisaProduto {
  id          String                      @id @default(cuid())
  execucaoId  String
  tenantId    String
  produtoId   String
  regra       String
  confianca   String
  confirmada  Boolean?
  revisadoPor String?
  revisadoEm  DateTime?
  observacao  String?
  criadoEm    DateTime                    @default(now())
  execucao    PesquisaCatalogoExecucao    @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  produto     Produto                     @relation(fields: [tenantId, produtoId], references: [tenantId, id], onDelete: Cascade)
  referencias ReferenciaPesquisaProduto[]
  fatos       FatoPesquisaProduto[]
  imagens     ImagemCandidataProduto[]

  @@unique([execucaoId, produtoId])
  @@index([tenantId, produtoId, confirmada])
}

model ReferenciaPesquisaProduto {
  id                String                         @id @default(cuid())
  correspondenciaId String
  fonteId           String
  tipo              String
  valor             String
  marca             String?
  evidencia         String?
  criadoEm          DateTime                       @default(now())
  correspondencia   CorrespondenciaPesquisaProduto @relation(fields: [correspondenciaId], references: [id], onDelete: Cascade)
  fonte             FontePesquisaCatalogo          @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@unique([correspondenciaId, fonteId, tipo, valor])
  @@index([tipo, valor])
}

model FatoPesquisaProduto {
  id                String                         @id @default(cuid())
  correspondenciaId String
  fonteId           String
  campo             String
  valor             Json
  confianca         String
  evidencia         String?
  criadoEm          DateTime                       @default(now())
  correspondencia   CorrespondenciaPesquisaProduto @relation(fields: [correspondenciaId], references: [id], onDelete: Cascade)
  fonte             FontePesquisaCatalogo          @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@unique([correspondenciaId, fonteId, campo])
}

model ImagemCandidataProduto {
  id                   String                         @id @default(cuid())
  correspondenciaId    String
  fonteId              String
  urlOriginal          String
  urlArmazenada        String?
  sha256               String?
  mime                 String?
  larguraPx            Int?
  alturaPx             Int?
  direitoUso           String                         @default("DESCONHECIDO")
  correspondenciaExata Boolean                        @default(false)
  estado               String                         @default("PENDENTE")
  promovidaUrl         String?
  promovidaEm          DateTime?
  criadoEm             DateTime                       @default(now())
  correspondencia      CorrespondenciaPesquisaProduto @relation(fields: [correspondenciaId], references: [id], onDelete: Cascade)
  fonte                FontePesquisaCatalogo          @relation(fields: [fonteId], references: [id], onDelete: Cascade)

  @@unique([correspondenciaId, urlOriginal])
  @@index([estado, criadoEm])
}

/// Cupom de desconto da loja.
model Cupom {
  id             String    @id @default(cuid())
  tenantId       String
  codigo         String // maiúsculo, sem espaço
  tipo           String // PERCENTUAL | FIXO | FRETE_GRATIS
  valor          Int       @default(0) // % (0–100) ou centavos
  minimoCentavos Int       @default(0)
  usosMax        Int?
  usos           Int       @default(0)
  validoAte      DateTime?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
}

/// Uma cobrança mensal da assinatura (authorized_payment do Mercado Pago).
model Fatura {
  id         String    @id @default(cuid())
  tenantId   String
  externalId String    @unique // id do authorized_payment
  centavos   Int
  status     String // approved | rejected | pending | …
  detalhe    String?
  pagaEm     DateTime?
  criadoEm   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
}

/// Notificação do Mercado Pago já vista — idempotência do webhook.
model CobrancaEvento {
  id            String    @id @default(cuid())
  notificacaoId String    @unique // "<topic>:<data.id>"
  tenantId      String?
  topico        String
  processadoEm  DateTime?
  erro          String?
  criadoEm      DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model PedidoItem {
  id                    String  @id @default(cuid())
  pedidoId              String
  produtoId             String?
  nome                  String
  sku                   String?
  quantidade            Int
  precoUnitarioCentavos Int
  varianteId            String?
  varianteNome          String?

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto  Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  variante Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
}

/// Checkout iniciado (a pessoa se identificou) mas ainda sem pedido. É a
/// matéria-prima do carrinho abandonado. Vira CONVERTIDO quando o pedido nasce.
model CheckoutAberto {
  id              String    @id @default(cuid())
  tenantId        String
  referencia      String    @unique
  clienteNome     String
  clienteEmail    String
  clienteTelefone String
  itens           Json // [{ id, nome, quantidade, precoUnitario }]
  totalCentavos   Int
  status          String    @default("ABERTO") // ABERTO | LEMBRADO | CONVERTIDO
  lembradoEm      DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, criadoEm])
}

/// Avaliação de produto pelo comprador. Só aparece depois de aprovada no painel.
model Avaliacao {
  id        String   @id @default(cuid())
  tenantId  String
  produtoId String
  nome      String
  nota      Int // 1–5
  texto     String?
  aprovada  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, aprovada])
  @@index([tenantId, aprovada, criadoEm])
}

/// Conta do comprador NA LOJA (não é o lojista). Escopo por tenant: o mesmo
/// e-mail pode ter conta em lojas diferentes, e uma loja nunca enxerga o
/// cadastro da outra.
model Comprador {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  senhaHash    String
  nome         String
  telefone     String?
  documento    String?
  criadoEm     DateTime  @default(now())
  ultimoAcesso DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enderecos EnderecoComprador[]
  pedidos   Pedido[]

  @@unique([tenantId, email])
}

/// Endereço salvo pelo comprador — evita redigitar CEP e rua a cada compra.
model EnderecoComprador {
  id          String  @id @default(cuid())
  compradorId String
  apelido     String?
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  principal   Boolean @default(false)

  comprador Comprador @relation(fields: [compradorId], references: [id], onDelete: Cascade)

  @@index([compradorId])
}

/// Quem pediu para ser avisado quando um produto voltar ao estoque. A rotina
/// horária do n8n emite `loja.voltou-ao-estoque` e marca `avisadoEm` — cada
/// pessoa é avisada uma vez por produto.
model AvisoEstoque {
  id        String    @id @default(cuid())
  tenantId  String
  produtoId String
  email     String
  telefone  String?
  criadoEm  DateTime  @default(now())
  avisadoEm DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, email])
  @@index([tenantId, avisadoEm])
}

/// Etiqueta emitida pela carteira da Avila Ops para despachar um pedido.
///
/// `custoCentavos` é o que saiu da nossa conta; `cobradoDoCompradorCentavos` é
/// o frete que o comprador pagou ao lojista. A diferença entre os dois é o que
/// a plataforma ganha ou perde no envio — e `acertadaEm` marca quando a gente
/// recebeu de volta.
model Postagem {
  id       String @id @default(cuid())
  tenantId String
  pedidoId String @unique

  servico                    String // pac | sedex | jadlog-package | jadlog-dotcom | loggi | mini
  codigoObjeto               String? // rastreio, quando a etiqueta sai
  custoCentavos              Int
  cobradoDoCompradorCentavos Int
  pdfEtiqueta                String?
  pdfDeclaracao              String?
  status                     String  @default("pendente") // pendente | emitida | cancelada | erro
  detalhe                    String?

  acertadaEm   DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([tenantId, acertadaEm])
}

/// Uma rotina agendada e o estado da última execução dela.
///
/// A plataforma se agenda sozinha (`src/lib/rotinas-agendador.ts`): antes quem
/// chamava os endpoints de tempos em tempos era o n8n, e a parte mais crítica
/// da operação dependia de um serviço de fora estar de pé. A linha é a trava:
/// vários containers tentam reivindicar a mesma rotina e só um leva, como em
/// `AutomacaoEvento`.
///
/// O nome é chave estável e vem de `ROTINAS` em `src/lib/rotinas.ts`.
model Rotina {
  nome            String    @id
  /// Quando vence de novo. Só é candidata quando <= agora.
  proximaEm       DateTime
  /// Preenchido enquanto alguém executa. Trava velha = processo que morreu no
  /// meio; depois de `travaMinutos` a rotina volta para a fila.
  executandoDesde DateTime?
  ultimaEm        DateTime?
  ultimaDuracaoMs Int?
  /// O resumo devolvido pela rotina (contagens). É o que a operação lê para
  /// saber que ela rodou de verdade, e não só que não deu erro.
  ultimoResumo    Json?
  ultimoErro      String?
  /// Zera a cada sucesso. Serve para ver "parou de funcionar" sem ler log.
  falhasSeguidas  Int       @default(0)
  execucoes       Int       @default(0)
  criadaEm        DateTime  @default(now())

  @@index([proximaEm])
}

enum AutomacaoEventoStatus {
  EMITIDO // a plataforma enviou ao n8n
  PROCESSANDO // o n8n reivindicou (primeira entrega)
  PROCESSADO
  FALHOU
  IGNORADO // válido, mas sem ação (ex.: PIX pago antes do lembrete)
  REENVIADO // falhou e foi reaberto como outro eventId; sai da fila
}

/// Um registro por evento emitido ao n8n. É a trava de idempotência (o n8n
/// reivindica pelo eventId antes de qualquer efeito externo) e o rastro de
/// "entreguei / executou".
model AutomacaoEvento {
  eventId        String                @id
  tipo           String
  slug           String
  versao         Int                   @default(1)
  status         AutomacaoEventoStatus @default(EMITIDO)
  detalhe        String?
  emitidoEm      DateTime              @default(now())
  reivindicadoEm DateTime?
  concluidoEm    DateTime?
  /// O envelope inteiro, como saiu. É o que torna o reenvio possível sem
  /// reconstruir o evento: FALHOU vira EMITIDO de novo com o mesmo corpo.
  payload        Json?
  /// Amarra os eventos de um mesmo pedido/loja numa só linha de investigação
  /// (referência do pedido, slug da loja). O n8n devolve o mesmo valor.
  correlationId  String?
  /// Quantas vezes já foi reenviado. Teto em `REENVIOS_MAXIMOS`.
  tentativas     Int                   @default(0)
  /// Quais canais deste evento já foram cumpridos ("email", "whatsapp").
  ///
  /// Um evento pode mandar e-mail ao comprador e WhatsApp ao lojista. Se o
  /// segundo falhar, a nova tentativa não pode reenviar o primeiro: quem já
  /// recebeu receberia duas vezes. A lista é gravada assim que cada canal sai.
  canaisFeitos   String[]              @default([])

  @@index([slug, tipo])
  @@index([status, emitidoEm])
  @@index([correlationId])
}

/// O anúncio de um produto nosso no Mercado Livre.
///
/// Espelho, não cópia: o produto continua sendo nosso e o anúncio é o reflexo
/// dele lá. Guardar o `MLB` é o que permite atualizar preço e estoque em vez de
/// criar anúncio duplicado a cada sincronização, que é o erro mais comum e o
/// que mais irrita o comprador.
///
/// `motivoErro` existe porque o ML recusa por atributo obrigatório faltando, e
/// sem guardar a resposta o lojista fica com um anúncio que "não subiu" sem
/// saber o que corrigir.
/// Saúde da conta da loja no Mercado Livre, como o próprio ML a calcula.
///
/// Uma linha por loja: é retrato, não histórico. O ML já guarda o histórico
/// dele, e o que o lojista precisa no painel é "como estou agora e o que está
/// me puxando para baixo".
model ReputacaoMercadoLivre {
  tenantId String @id

  /// newbie | 1_red | 2_orange | 3_yellow | 4_light_green | 5_green
  nivel         String?
  /// platinum | gold | silver | null — o selo de Mercado Líder.
  selo          String?
  transacoes    Int     @default(0)
  concluidas    Int     @default(0)
  canceladas    Int     @default(0)
  /// Percentuais como o ML devolve (0 a 100), com uma casa.
  reclamacoes   Float?
  atrasos       Float?
  cancelamentos Float?
  positivas     Float?
  neutras       Float?
  negativas     Float?

  /// O que está puxando a reputação para baixo, em português, já resolvido
  /// contra os limites que o ML publica. Texto e não código: quem lê é o
  /// lojista, e a régua do ML muda sem avisar.
  alertas Json @default("[]")

  medidoEm     DateTime
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Pergunta de comprador no Mercado Livre.
///
/// Fica aqui, e não só no ML, por dois motivos: no ML a pergunta se perde na
/// caixa de entrada de quem tem muitos anúncios, e responder rápido é o que
/// converte — a loja precisa poder cobrar a resposta e medir o tempo dela.
model PerguntaMercadoLivre {
  id       String @id @default(cuid())
  tenantId String
  /// Id da pergunta no ML. Único: o aviso chega repetido.
  mlId     String @unique

  mlbId     String
  anuncioId String?
  produtoId String?

  texto String
  /// Apelido de quem perguntou. O ML não entrega contato, e não se inventa.
  autor String?

  /// UNANSWERED | ANSWERED | CLOSED_UNANSWERED | UNDER_REVIEW | BANNED | DELETED,
  /// mais `RESPONDENDO`, que é só nosso: a reivindicação entre o clique do
  /// painel e o ML aceitar, para dois cliques não virarem duas respostas
  /// públicas. Continua na fila do lojista, porque ainda não foi respondida.
  statusMl      String    @default("UNANSWERED")
  resposta      String?
  /// Quem respondeu daqui: operador da loja. Resposta que veio do app do ML
  /// entra sem operador, e é assim que se distingue uma da outra.
  respondidaPor String?
  respondidaEm  DateTime?
  /// Motivo da recusa do ML (pergunta banida, resposta com contato, etc.).
  motivoErro    String?

  perguntadaEm DateTime
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anuncio AnuncioMercadoLivre? @relation(fields: [anuncioId], references: [id], onDelete: SetNull)
  produto Produto?             @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([tenantId, statusMl, perguntadaEm])
  @@index([tenantId, mlbId])
}

model AnuncioMercadoLivre {
  id        String @id @default(cuid())
  tenantId  String
  produtoId String

  /// Id do anúncio no ML (MLB1234567890). Nulo enquanto é rascunho.
  mlbId               String?   @unique
  categoriaMl         String?
  /**
   * Quem decidiu a categoria: `automatica` (preditor do ML) ou `manual` (o
   * lojista escolheu na tela).
   * É coluna, e não campo do `preparo`, porque o preditor precisa consultá-la
   * **antes** de rodar: escolha manual é palavra final, e uma escolha que some
   * no repreparo seguinte é pior que escolha nenhuma — o lojista arruma,
   * publica errado uma semana depois e não tem como saber por quê.
   */
  categoriaOrigem     String    @default("automatica")
  categoriaDefinidaEm DateTime?

  /**
   * Quem criou o anúncio: `propria` (publicamos daqui) ou `adotada` (já
   * existia no Mercado Livre do lojista e foi vinculada).
   *
   * Decide de quem é o **texto**. Anúncio adotado tem título, fotos e
   * descrição escritos pelo lojista, e a sincronia não os reescreve: ele nos
   * autorizou a cuidar de preço e estoque, não a trocar o anúncio dele. Sem
   * esta coluna o caso passava despercebido — um produto preparado antes de
   * ser adotado guarda o `preparo`, e `conteudoDoAnuncio` então devolve
   * conteúdo em vez de nulo.
   */
  origem              String    @default("propria")
  /// active | paused | closed | under_review
  statusMl            String?
  permalink           String?

  /// rascunho | publicando | publicado | recusado | pausado
  estado     String  @default("rascunho")
  motivoErro String?

  /// Preço e estoque com que foi publicado, para saber o que mudou desde então.
  precoCentavosPublicado Int?
  estoquePublicado       Int?
  /// Impressão digital do conteúdo publicado (título, fotos e descrição). O
  /// anúncio só é reescrito quando ela muda: sem isso, ou o conteúdo da loja
  /// nunca chegava ao anúncio, ou todo ciclo reenviaria tudo de novo.
  conteudoHash           String?

  /// Preparo antes de publicar: nome enriquecido, categoria prevista, atributos
  /// conferidos e o veredito. Fica aqui e não em `Produto` porque é opinião de
  /// um canal sobre o produto, não fato do produto: a mesma peça pode estar
  /// pronta para o Mercado Livre e bloqueada na Amazon.
  preparo       Json?
  /// PRONTO | REVISAO | BLOQUEADO. Coluna própria para listar "o que falta
  /// resolver" sem varrer o JSON de milhares de produtos.
  preparoEstado String?
  preparadoEm   DateTime?

  sincronizadoEm DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto   Produto                @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  perguntas PerguntaMercadoLivre[]

  @@unique([tenantId, produtoId])
  @@index([tenantId, estado])
  @@index([tenantId, preparoEstado])
  @@index([tenantId, categoriaOrigem])
}

/// Quem trabalha na loja e entra no painel.
///
/// Antes era uma senha por loja, gravada no proprio `Tenant`. Numa loja com
/// equipe isso significa que o dono, quem separa pedido e quem cadastra produto
/// usam a mesma senha: ninguem sabe quem despachou o que, e quando alguem sai
/// da empresa a senha muda para todo mundo ao mesmo tempo.
///
/// Quem cria e remove e o proprio lojista, pela tela do painel. O
/// `Tenant.loginEmail` continua sendo o dono da loja: ele nao aparece nesta
/// tabela, nao pode ser removido pela tela e e o caminho de volta se a equipe
/// se trancar fora. Ver src/lib/operadores.ts.
model OperadorLoja {
  id       String @id @default(cuid())
  tenantId String

  nome      String
  email     String
  /// scrypt, mesmo formato do lojista e do comprador (src/lib/sessao.ts).
  senhaHash String

  /// GERENTE | OPERADOR
  ///
  /// GERENTE cuida da loja (produto, preco, pedido, promocao) mas nao mexe em
  /// assinatura nem em quem entra. OPERADOR e o balcao: ve e despacha pedido, e
  /// nao muda preco. O dono nao esta aqui: ele e o Tenant.
  papel String @default("OPERADOR")

  /// Desligar nao apaga: o historico de quem despachou cada pedido tem que
  /// continuar apontando para uma pessoa.
  ativo Boolean @default(true)

  ultimoAcessoEm DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// O mesmo e-mail pode operar em lojas diferentes (contador, agencia), mas
  /// nunca duas vezes na mesma loja.
  @@unique([tenantId, email])
  @@index([tenantId, ativo])
}

/// Publicação do blog DA LOJA (não confundir com o blog da plataforma, que é
/// arquivo em src/lib/blog.ts). Escopo por tenant: o conteúdo de uma loja
/// nunca aparece na outra, nem no feed, nem na busca.
model PublicacaoLoja {
  id       String  @id @default(cuid())
  tenantId String
  slug     String
  titulo   String
  /// Chamada curta: lista, card social e <meta description>. Sem ela, a
  /// listagem corta o corpo, e corpo cortado no meio de uma frase é pior do
  /// que resumo escrito.
  resumo   String?
  /// Corpo em texto com parágrafos separados por linha em branco. Não é HTML:
  /// o que o lojista escreve nunca vira marcação executável na vitrine.
  corpo    String
  capaUrl  String?
  autor    String?

  /// rascunho | publicada. Rascunho não existe para a vitrine — nem por URL
  /// direta, nem no sitemap.
  estado      String    @default("rascunho")
  publicadoEm DateTime?

  seoTitle       String?
  seoDescription String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, estado, publicadoEm])
}

/// Visita à vitrine, com a origem que a trouxe.
///
/// É a base da Atribuição: sem sessão medida, "sessões por canal" e "taxa de
/// conversão" não existem — só vendas. A medição é first-party (cookie do
/// próprio domínio da loja, nenhum dado sai para terceiros) e não guarda IP
/// nem identificação do visitante: `visitante` é um valor opaco sorteado no
/// primeiro acesso, que serve para ligar a sessão de hoje à de ontem e nada
/// mais.
model SessaoVitrine {
  id        String @id @default(cuid())
  tenantId  String
  /// Valor do cookie de sessão. Único global porque é sorteado com 128 bits.
  chave     String @unique
  /// Valor do cookie de visitante: liga sessões da mesma pessoa, e é o que
  /// permite o "último clique não direto" enxergar além da sessão da compra.
  visitante String

  /// Canal resolvido a partir de utm/referrer. Ver CANAIS em src/lib/atribuicao.ts.
  canal    String
  /// utm_source, ou o host de quem indicou quando não há utm.
  origem   String?
  midia    String? // utm_medium
  campanha String? // utm_campaign
  termo    String? // utm_term
  conteudo String? // utm_content
  referrer String?
  /// Primeira página vista nesta sessão: é o que responde "por onde entraram".
  entrada  String

  /// celular | tablet | computador. Classificado do user-agent, sem guardá-lo.
  dispositivo String @default("computador")

  /// Contadores da sessão. Ficam aqui, e não numa tabela de eventos, porque a
  /// pergunta do painel é por sessão: quantas entraram, quantas viram produto,
  /// quantas compraram. Guardar um registro por clique custaria muito mais
  /// para responder exatamente a mesma coisa.
  paginas         Int     @default(1)
  viuProduto      Boolean @default(false)
  iniciouCheckout Boolean @default(false)

  criadoEm DateTime @default(now())
  ultimoEm DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([tenantId, criadoEm])
  @@index([tenantId, canal, criadoEm])
  @@index([tenantId, visitante, criadoEm])
}

enum TipoChaveApi {
  SECRETA // servidor do lojista: catálogo e pedidos, por escopo
  PUBLICAVEL // pode ir no navegador: só a vitrine pública
}

/// Chave da API para desenvolvedores (`/api/v1`). Ver docs/API.md.
///
/// Guarda o sha256 da chave, nunca a chave: diferente do token de gateway, que
/// a loja precisa decifrar para falar com o Mercado Pago, esta só precisa ser
/// reconhecida. Dump do banco não devolve chave que funcione. Uma loja tem
/// quantas quiser (uma por integração), e revogar uma não derruba as outras.
model ChaveApi {
  id       String       @id @default(cuid())
  tenantId String
  tipo     TipoChaveApi
  /// Rótulo do lojista: "ERP", "App iOS". Só para ele reconhecer a chave.
  nome     String
  /// sha256 hex da chave inteira. É por ele que a requisição acha a chave.
  hash     String       @unique
  /// Começo e fim da chave, para o painel mostrar "lojas_sk_3f9a…c21e".
  prefixo  String
  final    String
  /// Escopos de `ESCOPOS` em src/lib/api-chaves.ts. Publicável é sempre ["vitrine:ler"].
  escopos  String[]

  ultimoUsoEm DateTime?
  revogadaEm  DateTime?
  criadaEm    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
