# lojas.avilaops.com — plataforma multi-tenant de lojas
#
# Uma instância serve todas as lojas. Nada aqui é "da loja X": o que varia por
# loja mora no banco (tabela Tenant), nunca em variável de ambiente.

# Postgres do host (o mesmo servidor Hetzner; o container acessa por host.docker.internal)
DATABASE_URL=postgresql://lojas:senha@host.docker.internal:5432/lojas

# Domínio-base das lojas. Toda loja nasce em <slug>.lojas.avilaops.com e
# ganha o domínio próprio depois que o DNS aponta para cá.
LOJAS_BASE_DOMAIN=lojas.avilaops.com

# Segredo que cifra tokens de gateway guardados no banco (AES-256-GCM).
# 32 bytes em hex: `openssl rand -hex 32`. Trocar invalida todos os tokens.
LOJAS_SECRET=

# Token da API administrativa (/api/admin/*). É o que o n8n e o portal usam.
LOJAS_ADMIN_TOKEN=

# Google Tag Manager do site da plataforma (página inicial, planos, blog,
# entrar, criar). Opcional: vazio = sem tag e sem aviso de cookies. As lojas não
# usam isto; cada uma tem o seu id no painel, aba Anúncios.
PLATAFORMA_GTM_ID=

# --- Login único da Avila Ops (opcional) ---
# Liga o botão "Entrar com a conta Avila Ops" em /entrar. O valor é o
# identificador do Lojas no cadastro de aplicações do Auth
# (auth.avilaops.com/admin/apps), que precisa estar marcado como "recebe sessão
# do login único". Vazio = desligado: sem botão, e a rota responde 404.
# A senha da loja continua valendo nos dois casos.
SSO_APP_ID=
# Endereço do Auth. Só mudar em ambiente de teste.
# SSO_URL=https://auth.avilaops.com

# --- Agendador interno ---
# A plataforma roda as próprias rotinas (fila do Mercado Livre a cada 5 min,
# carrinho abandonado, cobrança, relatório semanal...). Ver docs/ROTINAS.md.
# Sem a variável: ligado em produção, desligado em desenvolvimento.
# `0` sobe um container que só serve requisições, sem relógio — a trava no
# banco já impede dois containers de fazerem a mesma rotina, então desligar
# é escolha de capacidade, não de segurança.
ROTINAS_AGENDADOR=

# --- Frete ---
# Melhor Envio: cada lojista conecta a própria conta por OAuth, na seção
# Entrega do painel. O aplicativo é um só, da plataforma, cadastrado no painel
# deles (Integrações → Área Dev → Aplicativos) com a URL de retorno
#   https://<LOJAS_BASE_DOMAIN>/melhor-envio/callback
# Sem estas duas variáveis o botão de conectar não aparece e as lojas cotam
# pela tabela de frete própria.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Ambiente de testes: https://sandbox.melhorenvio.com.br (o aplicativo é
# outro, cadastrado lá). Vazio usa a produção.
MELHOR_ENVIO_URL=
# E-mail de contato que vai no User-Agent, exigido pela API. Padrão: lojas@avilaops.com
MELHOR_ENVIO_CONTATO=
# Opcional: ids dos serviços a oferecer, separados por vírgula. Vazio oferece
# todos os que atendem o trecho.
MELHOR_ENVIO_SERVICOS=
# CepCerto: só a emissão de etiqueta antiga (src/lib/postagem.ts) ainda lê esta
# chave. Com o Melhor Envio configurado, a emissão por ela fica travada.
CEPCERTO_POSTAGEM_KEY=

# --- Provisionamento (cada um opcional: sem a variável o passo é pulado e
#     fica registrado como "pendente" no tenant) ---
# Cloudflare: token com Zone:Edit + DNS:Edit na conta da Avila Ops — ou, na
# falta dele, e-mail + chave global (menos seguro; trocar assim que houver token).
CLOUDFLARE_TOKEN=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_GLOBAL_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Para onde o DNS da loja aponta (A do host que roda o Caddy)
LOJAS_IPV4=
LOJAS_IPV6=

# mail.avilaops.com — API de provisionamento (loopback no host)
MAIL_API_URL=http://host.docker.internal:3042/api/v1
MAIL_API_TOKEN=

# --- E-mail (SMTP próprio) ---
# A plataforma manda os próprios e-mails desde 19/09/2026 (docs/MENSAGENS.md).
# Sem estas variáveis o caminho fica desligado e os eventos voltam a ir para o
# n8n — é o que faz esta mudança nascer inerte até alguém ligar.
# Porta 465 = TLS desde o primeiro byte. 587 = STARTTLS depois do EHLO.
SMTP_HOST=mail.avilaops.com
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
# Remetente padrão, usado quando a loja não tem `pedidos@<apex>` provisionado.
EMAIL_REMETENTE=lojas@avilaops.com
EMAIL_REMETENTE_NOME=Avila Ops

# --- WhatsApp (Cloud API da Meta) ---
# Templates aprovados em docs/WHATSAPP-TEMPLATES.md. Sem estas duas variáveis
# os tipos que mandam WhatsApp voltam INTEIROS para o n8n — e-mail e WhatsApp —,
# porque executar metade faz o aviso do lojista sumir sem ninguém notar.
# Token de System User permanente, não o temporário de 24 h.
WHATSAPP_TOKEN=
# O Phone Number ID da conta, não o número de telefone.
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSAO=v21.0

# n8n — webhook que recebe os eventos da plataforma (loja criada, pedido pago…)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Enriquecimento offline de catálogo e SEO (nunca é chamado no request público)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Canais de venda ---
# Mercado Livre: o aplicativo é DA PLATAFORMA (um só para todas as lojas), e a
# conta de vendedor é de cada lojista, autorizada por OAuth em
# painel → Configurações → Canais. Criar em https://developers.mercadolivre.com.br
# com a URL de retorno https://<LOJAS_BASE_DOMAIN>/ml/callback e o escopo
# offline_access — sem ele não vem refresh token e a integração morre em 6 h.
# Sem estas duas, o painel esconde o botão de conectar em vez de mandar o
# lojista para uma tela de erro do próprio Mercado Livre.
ML_APP_ID=
ML_APP_SECRET=

# Amazon, Shopee e Magalu seguem a mesma regra: o aplicativo é da plataforma,
# a conta é de cada lojista, e sem as variáveis do canal o botão de conectar
# daquele canal não aparece. Conectar ainda não publica anúncio nesses três.
# A URL de retorno a cadastrar em cada aplicativo é
#   https://<LOJAS_BASE_DOMAIN>/canais/<amazon|shopee|magalu>/callback
#
# Shopee Open Platform (https://open.shopee.com): Partner ID e Partner Key do
# aplicativo. Toda chamada é assinada com a chave; ela nunca sai do servidor.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# No Console da Shopee, o domínio do retorno precisa estar em "Redirect URL Domain".
# Ambiente de testes (o parceiro é outro, criado lá). Vazio usa a produção.
#   SHOPEE_AUTH_URL=https://open.sandbox.test-stable.shopee.com.br/auth
#   SHOPEE_URL=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_AUTH_URL=
SHOPEE_URL=
#
# Amazon SP-API (Seller Central → Apps e Serviços → Desenvolver aplicativos).
# AMAZON_APP_ID é o "application id" (amzn1.sellerapps.app.…), que identifica o
# aplicativo na autorização; client id e secret são as credenciais LWA dele.
# A URL de retorno acima precisa ser o PRIMEIRO "OAuth Redirect URI" do
# aplicativo: a Amazon volta para ele, a autorização não escolhe outro.
AMAZON_APP_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# "1" enquanto o aplicativo estiver em rascunho: sem isso o Seller Central diz
# que o aplicativo não existe. Tirar depois de publicado.
AMAZON_APP_RASCUNHO=
#
# Magalu (https://developers.magalu.com): cliente criado pela CLI `idm`, com a
# URL de retorno em --redirect-uris e os escopos de seller aprovados.
MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=
# Opcional: escopos separados por espaço, se o Magalu aprovou um conjunto
# diferente do padrão de src/lib/canal-magalu.ts.
MAGALU_ESCOPOS=

# --- Mensalidade das lojas (conta Mercado Pago da AVILA OPS, não do lojista) ---
# Assinatura (preapproval) mensal por plano: Site 79 / Loja 119 / Loja Pro 349.
# Webhook a cadastrar no painel MP: https://lojas.avilaops.com/api/webhooks/mercadopago-assinatura
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Dias de tolerância depois do teste (14 dias) ou de um mês sem pagamento
LOJAS_DIAS_TOLERANCIA=7

# Rodapé "Loja por Avila Ops" — o link do rodapé aponta para cá
AVILAOPS_URL=https://avilaops.com

# on_demand_tls do Caddy: o "ask" global aponta para cá; host que não é loja é
# repassado para o ask anterior (Comandeiro), para não quebrar quem já usava.
TLS_ASK_FALLBACK_URL=http://127.0.0.1:3040/api/domains/check
