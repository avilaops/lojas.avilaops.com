import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { mkdir } from "node:fs/promises";
import { chromium } from "playwright";
import forge from "node-forge";
import { prisma } from "../src/lib/db";
import { gerarHashSenha } from "../src/lib/sessao";

const db = new URL(process.env.DATABASE_URL ?? "http://invalid");
if (db.hostname !== "127.0.0.1" || db.port !== "5588" || !db.pathname.endsWith("_test")) throw new Error("QA fiscal exige banco local isolado :5588/*_test.");
const base = "http://localhost:3088";
const chave = randomUUID();
const email = `fiscal-${chave}@example.test`;
const senha = "Senha-local-QA-123";
const cnpj = "12345678000190";
const loja = await prisma.tenant.create({ data: { slug: `fiscal-${chave}`, nome: "Loja de teste fiscal", cnpj, loginEmail: email, senhaHash: gerarHashSenha(senha), status: "ATIVA" } });
const browser = await chromium.launch({ headless: true });
const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
const page = await context.newPage();
const erros: string[] = [];
page.on("pageerror", (erro) => erros.push(erro.message));
try {
  await page.goto(`${base}/entrar?senha=1`, { waitUntil: "networkidle", timeout: 120_000 });
  await page.getByRole("textbox", { name: "E-mail", exact: true }).fill(email);
  await page.getByLabel("Senha", { exact: true }).fill(senha);
  await page.getByRole("button", { name: "Entrar", exact: true }).click();
  await page.waitForURL(`${base}/painel`, { timeout: 120_000 });
  await page.goto(`${base}/painel/configuracoes/fiscal`, { waitUntil: "networkidle", timeout: 120_000 });
  await page.getByRole("button", { name: "Guardar certificado" }).waitFor();
  const chaves = forge.pki.rsa.generateKeyPair(2048);
  const cert = forge.pki.createCertificate();
  cert.publicKey = chaves.publicKey; cert.serialNumber = "01";
  cert.validity.notBefore = new Date(Date.now() - 86_400_000);
  cert.validity.notAfter = new Date(Date.now() + 86_400_000);
  cert.setSubject([{ name: "commonName", value: `LOJA DE TESTE:${cnpj}` }]);
  cert.setIssuer(cert.subject.attributes); cert.sign(chaves.privateKey, forge.md.sha256.create());
  const buffer = Buffer.from(forge.asn1.toDer(forge.pkcs12.toPkcs12Asn1(chaves.privateKey, cert, "teste", { algorithm: "3des" })).getBytes(), "binary");
  await page.getByLabel("Arquivo do certificado").setInputFiles({ name: "teste.pfx", mimeType: "application/x-pkcs12", buffer });
  await page.getByLabel("Senha do certificado").fill("errada");
  await page.getByLabel("UF da empresa").selectOption("SP");
  await page.getByRole("button", { name: "Guardar certificado" }).click();
  await page.getByRole("alert").filter({ hasText: "Não foi possível abrir" }).waitFor();
  await page.getByLabel("Senha do certificado").fill("teste");
  await page.getByRole("button", { name: "Guardar certificado" }).click();
  await page.getByRole("status").filter({ hasText: "Certificado guardado" }).waitFor();
  assert.equal(await page.getByLabel("Senha do certificado").inputValue(), "");
  assert.equal(await page.getByLabel("Senha do certificado").isVisible(), false);
  await page.getByText("Substituir certificado", { exact: true }).click();
  assert.equal(await page.getByLabel("Senha do certificado").isVisible(), true);
  await page.getByText("Substituir certificado", { exact: true }).click();
  const estado = await (await context.request.get(`${base}/api/painel/fiscal`)).json();
  assert.equal(estado.configuracao.cnpj, cnpj);
  assert.ok(!("certificadoEnc" in estado.configuracao));
  const bloqueado = await context.request.post(`${base}/api/painel/fiscal?acao=consultar`, { headers: { Origin: "https://outra-origem.example" } });
  assert.equal(bloqueado.status(), 403);
  const semOrigem = await context.request.post(`${base}/api/painel/fiscal?acao=consultar`);
  assert.equal(semOrigem.status(), 403);
  const origemForjada = await context.request.post(`${base}/api/painel/fiscal?acao=consultar`, {
    headers: { Origin: "https://outra-origem.example", "X-Forwarded-Host": "outra-origem.example", "X-Forwarded-Proto": "https" },
  });
  assert.equal(origemForjada.status(), 403);
  await prisma.fiscalLoja.update({ where: { tenantId: loja.id }, data: { proximaConsultaEm: new Date(Date.now() + 3_600_000) } });
  await page.getByRole("button", { name: "Consultar próximo lote" }).click();
  await page.getByRole("alert").filter({ hasText: "intervalo de espera" }).waitFor();
  const doc = await prisma.documentoFiscalLoja.create({ data: { tenantId: loja.id, cnpj, nsu: "000000000000001", schema: "resNFe_v1.01.xsd", chave: "1".repeat(44), xml: "<resNFe><xNome>Fornecedor de teste</xNome></resNFe>" } });
  await page.reload({ waitUntil: "networkidle" });
  await page.getByRole("link", { name: "Baixar XML" }).waitFor();
  await page.getByText("Resumo de NF-e", { exact: true }).waitFor();
  assert.equal(await page.getByText(doc.schema, { exact: true }).isVisible(), false);
  const xml = await context.request.get(`${base}/api/painel/fiscal/documentos/${doc.id}`);
  assert.equal(xml.status(), 200); assert.equal(await xml.text(), doc.xml);
  const anonimo = await browser.newContext();
  assert.equal((await anonimo.request.get(`${base}/api/painel/fiscal/documentos/${doc.id}`)).status(), 401);
  await anonimo.close();
  await prisma.operadorLoja.create({ data: { tenantId: loja.id, nome: "Gerente QA", email: `gerente-${chave}@example.test`, senhaHash: gerarHashSenha(senha), papel: "GERENTE" } });
  const gerente = await browser.newContext();
  assert.equal((await gerente.request.post(`${base}/api/painel/entrar`, { data: { email: `gerente-${chave}@example.test`, senha } })).status(), 200);
  assert.equal((await gerente.request.get(`${base}/api/painel/fiscal`)).status(), 403);
  assert.equal((await gerente.request.get(`${base}/api/painel/fiscal/documentos/${doc.id}`)).status(), 403);
  await gerente.close();
  await mkdir("output/fiscal-qa", { recursive: true });
  await page.screenshot({ path: "output/fiscal-qa/desktop.png", fullPage: true });
  await page.setViewportSize({ width: 393, height: 852 });
  await page.screenshot({ path: "output/fiscal-qa/mobile.png", fullPage: true });
  assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), "A tela não pode transbordar no celular.");
  await page.setViewportSize({ width: 320, height: 852 });
  await page.getByText("Identificação do documento", { exact: true }).click();
  assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth), "A chave de 44 dígitos não pode transbordar em 320 px.");
  assert.deepEqual(erros, []);
  console.log("QA fiscal: login, upload, senha incorreta, cofre, origem, intervalo, XML, permissões, desktop e celular aprovados.");
} finally {
  await browser.close();
  await prisma.operadorLoja.deleteMany({ where: { tenantId: loja.id } });
  await prisma.documentoFiscalLoja.deleteMany({ where: { tenantId: loja.id } });
  await prisma.fiscalLoja.deleteMany({ where: { tenantId: loja.id } });
  await prisma.tenant.delete({ where: { id: loja.id } });
  await prisma.$disconnect();
}
