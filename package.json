{
  "name": "lojas-avilaops",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multi-tenant de lojas virtuais da Avila Ops : um código, N lojas",
  "scripts": {
    "dev": "next dev -p 3080",
    "build": "prisma generate && next build",
    "start": "next start -p 3080",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:atelie": "tsx scripts/seed-atelie.ts",
    "loja:criar": "tsx scripts/criar-loja.ts",
    "loja:publicacao": "tsx scripts/conferir-publicacao.ts",
    "loja:marcas": "tsx scripts/conferir-marca-catalogo.ts",
    "loja:auditar": "node scripts/auditoria/executar.mjs",
    "auditoria:n8n": "node scripts/auditoria/gerar-n8n.mjs",
    "test:auditoria": "node --test scripts/auditoria/core.test.mjs scripts/auditoria/workflow.test.mjs",
    "test": "tsx --test src/lib/*.test.ts packages/checkout/src/core/*.test.ts packages/checkout/src/server/*.test.ts packages/checkout/src/providers/*.test.ts",
    "banco:teste": "node scripts/banco-de-teste.mjs subir",
    "banco:teste:parar": "node scripts/banco-de-teste.mjs derrubar",
    "banco:ensaio": "node --import tsx scripts/ensaio-banco.mts",
    "test:integracao": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@avilaops/checkout": "file:./packages/checkout",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@google/genai": "^2.19.0",
    "@langfuse/otel": "6.0.2",
    "@langfuse/tracing": "6.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/client": "^6",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.477.0",
    "next": "16.2.10",
    "node-forge": "^1.4.0",
    "onnxruntime-node": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.1",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
