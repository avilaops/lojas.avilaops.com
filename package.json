{
  "name": "lojas-avilaops",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multi-tenant de lojas virtuais da Avila Ops — um código, N lojas",
  "scripts": {
    "dev": "next dev -p 3080",
    "build": "prisma generate && next build",
    "start": "next start -p 3080",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "loja:criar": "tsx scripts/criar-loja.ts",
    "loja:publicacao": "tsx scripts/conferir-publicacao.ts",
    "test": "tsx --test src/lib/*.test.ts ../ferramentas/packages/checkout/src/core/*.test.ts ../ferramentas/packages/checkout/src/server/*.test.ts ../ferramentas/packages/checkout/src/providers/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@avilaops/checkout": "file:../ferramentas/packages/checkout",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^6",
    "lucide-react": "^0.477.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.62.1",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
