# Redirects de brilhax.com depois da virada para a plataforma.
#
# A primeira versão usava `redir /produtos/categoria/* ... {path.1}` e mandava
# TODAS as categorias para `/categoria/categoria`, porque `path.1` é o segundo
# segmento ("categoria"), não o terceiro. O erro só apareceu porque a regra foi
# executada de verdade; conferir a lista de destinos não o teria encontrado.
# NÃO APLICADO. Entra no bloco de brilhax.com no dia da virada, com
# autorização. Testado numa instância isolada do Caddy em 10/09/2026.
#
# Cobre 12 das 117 URLs do sitemap antigo. As outras 105 NÃO levam redirect de
# propósito: o domínio continua brilhax.com e o caminho é o mesmo, então só a
# barra final muda e a própria aplicação devolve 308. Redirect que aponta para
# a mesma URL é ruído que o Google trata como soft 404.
brilhax.com {
	# --- categorias -------------------------------------------------------
	# Os dois slugs que mudaram vêm ANTES do caso geral: a plataforma gera o
	# slug a partir do nome ("Kits Completos" -> kits-completos) e o Medusa
	# guardava um mais curto.
	@kits path /produtos/categoria/kits /produtos/categoria/kits/
	redir @kits /categoria/kits-completos{http.request.uri.prefixed_query} permanent

	@moto path /produtos/categoria/moto /produtos/categoria/moto/
	redir @moto /categoria/produtos-para-moto{http.request.uri.prefixed_query} permanent

	# Caso geral: só UM segmento depois de /produtos/categoria/, e a barra
	# final opcional. `/produtos/categoria/lavagem/extra` não casa e cai no
	# 404 da aplicação, que é o certo: aquela URL nunca existiu.
	@categoria path_regexp cat ^/produtos/categoria/([^/]+)/?$
	redir @categoria /categoria/{http.regexp.cat.1}{http.request.uri.prefixed_query} permanent

	@indiceCategorias path /produtos/categoria /produtos/categoria/
	redir @indiceCategorias /produtos permanent

	# --- políticas --------------------------------------------------------
	@envio path /politica-de-envio /politica-de-envio/
	redir @envio /politicas/envio permanent

	@devolucao path /politica-de-devolucao /politica-de-devolucao/
	redir @devolucao /politicas/devolucao permanent

	@privacidade path /politica-de-privacidade /politica-de-privacidade/
	redir @privacidade /politicas/privacidade permanent

	@termos path /termos-de-uso /termos-de-uso/
	redir @termos /politicas/termos permanent

	# Tudo o mais segue para a aplicação, sem redirect: é a decisão para 105
	# das 117 URLs. Inclui o 308 que tira a barra final, que o Next já faz.
	#
	# O import abaixo é o mesmo do resto das lojas com domínio próprio; o
	# bloco real sai do caddy-sync.sh, e este arquivo é só a parte de
	# redirects que precisa ser somada a ele.
	# import lojas_upstream
}
