# Trecho aplicado no Caddy do Hetzner em 24/08/2026 (referência; o arquivo vivo é
# /etc/caddy/Caddyfile no servidor).
#
# 1) Opções globais — o "ask" do on_demand_tls passou a ser a plataforma, que
#    repassa ao Comandeiro (3040) qualquer host que não seja loja:
#
#   {
#     on_demand_tls {
#       ask http://127.0.0.1:3080/api/dominio-permitido
#     }
#   }
#
# 2) Bloco das lojas. Sem certificado wildcard (o Caddy instalado não tem o
#    módulo DNS da Cloudflare): cada <slug>.lojas.avilaops.com e cada domínio
#    próprio ganha o seu certificado sob demanda na primeira visita.

lojas.avilaops.com, *.lojas.avilaops.com {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3080
}

# Domínios próprios das lojas caem no bloco https:// já existente (Comandeiro),
# que faz reverse_proxy para 3040 — por isso o passo "dns" do provisionamento
# ainda precisa de um bloco por domínio OU de trocar o destino do https:// para
# um roteador. Pendência anotada em docs/produtos/LOJAS-AVILAOPS.md.

# ---------------------------------------------------------------------------
# 03/09/2026 — cabeçalhos de segurança no bloco das lojas.
#
# O Lighthouse apontou CSP e HSTS ausentes com gravidade Alta: o bloco das
# lojas não tinha cabeçalho nenhum, embora os outros sites do servidor já os
# tivessem.
#
# A CSP entra em **modo de relato**, e não bloqueando. A vitrine carrega pixel
# de rastreio configurado por cada lojista (Google Tag Manager, Meta, TikTok), e
# derrubar o checkout de um cliente para passar numa auditoria seria trocar
# problema real por selo. Depois de conferir o relato, `-Report-Only` sai do
# nome do cabeçalho e a política passa a valer.
#
# Estado vivo no servidor (/etc/caddy/Caddyfile):

lojas.avilaops.com, *.lojas.avilaops.com {
	tls {
		on_demand
	}
	encode zstd gzip

	# Cabecalhos de seguranca. Apontados pelo Lighthouse em 03/09/2026 como
	# gravidade Alta: nenhum estava presente aqui, embora os outros sites do
	# servidor ja os tivessem.
	#
	# A CSP vai em modo de RELATO, e nao bloqueando: a vitrine carrega pixel de
	# rastreio configurado por cada lojista (GTM, Meta, TikTok) e derrubar o
	# checkout de um cliente para passar numa auditoria seria trocar problema
	# real por selo. Depois de conferir que nada quebra, vira Content-Security-Policy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.mercadopago.com.br"
	}

	reverse_proxy 127.0.0.1:3080
}

# ---------------------------------------------------------------------------
# 28/09/2026 — receptor do ProCommerce da VedaShow.
#
# A tarefa agendada no SERVIDOR da loja física manda o cadastro de produtos
# para /integracoes/erp/vedashow/*, que não é da plataforma: é o serviço
# vedashow-sync (vedashow.com.br/etl/receptor_erp.py) em 127.0.0.1:5191. O
# handle entra no bloco das lojas, antes do reverse_proxy da plataforma:
#
#	handle /integracoes/erp/* {
#		reverse_proxy 127.0.0.1:5191
#	}

# ---------------------------------------------------------------------------
# 08/10/2026 — teto de corpo nas rotas do painel.
#
# A aplicação recusa envio grande pelo content-length antes de ler o corpo
# (src/lib/limites-upload.ts: o maior teto é o da planilha, 12 MiB + 64 KiB de
# envelope multipart). Envio em pedaços (Transfer-Encoding: chunked) chega sem
# o cabeçalho, e o formData() leria tudo para a memória. O Caddy corta em
# 13 MiB com 413, com ou sem content-length, e só em /api/painel/*: o resto do
# site não muda. Se o teto da aplicação subir, este sobe junto
# (docs/ISOLAMENTO-OPERACIONAL.md).
#
# Estado vivo no servidor (/etc/caddy/Caddyfile), fora de qualquer bloco de site:

(lojas_teto_corpo) {
	@lojas_painel_api path /api/painel/*
	request_body @lojas_painel_api {
		max_size 13MiB
	}
}

# O snippet é importado nos três blocos que levam à plataforma, logo depois de
# `import lojas_log`; num só, o teto seria contornável pelo domínio próprio:
#
#   1. `lojas.avilaops.com, *.lojas.avilaops.com`, no /etc/caddy/Caddyfile;
#   2. /etc/caddy/lojas.d/brilhax.caddy, mantido à mão;
#   3. /etc/caddy/lojas.d/dominios.caddy, gerado por deploy/caddy-sync.sh.
#
#	import lojas_vitrine_cache
#	import lojas_log
#	import lojas_teto_corpo

# Cabeçalhos de segurança dos domínios próprios das lojas (08/10/2026). O bloco
# de lojas.avilaops.com já os tinha; os domínios gerados pelo caddy-sync.sh e o
# brilhax.caddy importam este trecho. HSTS sem includeSubDomains: o domínio é do
# lojista e pode ter subdomínio fora daqui. A CSP segue em modo de relato.
(lojas_cabecalhos) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.mercadopago.com.br"
	}
}
