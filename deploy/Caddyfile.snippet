# Trecho para o Caddy do host Hetzner.
#
# Duas entradas: o curinga da plataforma e os domínios próprios das lojas.
# Domínio próprio novo NÃO exige mexer aqui: o on_demand_tls emite o
# certificado na primeira visita, e a plataforma decide (pelo Host) se aquele
# domínio pertence a alguma loja — /api/health?host= é o "ask" do Caddy.

{
  on_demand_tls {
    ask http://127.0.0.1:3070/api/dominio-permitido
  }
}

# Curinga: precisa de DNS-01 na Cloudflare (módulo caddy-dns/cloudflare).
*.lojas.avilaops.com {
  tls {
    dns cloudflare {env.CLOUDFLARE_TOKEN}
  }
  reverse_proxy 127.0.0.1:3070
}

# Domínios próprios das lojas (qualquer um; certificado sob demanda).
https:// {
  tls {
    on_demand
  }
  reverse_proxy 127.0.0.1:3070
}
